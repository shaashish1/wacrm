{
  "name": "@wacrm/web",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hostable CRM template for WhatsApp built on Next.js and Supabase — shared inbox, contacts, sales pipelines, broadcasts, and no-code automations.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/ArnasDon/wacrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnasDon/wacrm.git"
  },
  "bugs": {
    "url": "https://github.com/ArnasDon/wacrm/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -p 3100",
    "dev:webpack": "node ./node_modules/next/dist/bin/next dev --webpack -p 3100",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start -p 3100",
    "lint": "eslint",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@wacrm/shared": "file:../../packages/shared",
    "@xyflow/react": "^12.11.0",
    "bullmq": "^5.7.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.51.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.2",
    "nodemailer": "^6.9.16",
    "opus-recorder": "^8.0.5",
    "posthog-js": "^1.200.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.11.0",
    "socket.io-client": "^4.7.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.10",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.34.5",
    "@msgpackr-extract/msgpackr-extract-linux-x64": "3.0.4",
    "@next/swc-linux-x64-gnu": "16.2.6",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@swc/core-linux-x64-gnu": "1.15.46",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.25",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6"
  }
}
