# Copy to `.env` for Docker Compose / production. Never commit the filled file.
# Local Next.js also reads `apps/web/.env.local` (see `.env.local.example`).

NODE_ENV=production

# Public origin of the CRM (no trailing slash). Production web listens on 3100.
NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en

# --- Supabase ---
# Hosted: Project Settings → API
# Local CLI: http://127.0.0.1:54321 and keys from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 64 hex chars (32 bytes). node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret — HMAC on inbound WhatsApp Cloud API webhooks.
META_APP_SECRET=your-meta-app-secret
# META_APP_ID=your-meta-app-id

# Redis (Compose overrides to redis://redis:6379)
REDIS_URL=redis://127.0.0.1:6379

# Cron routes: /api/broadcasts/cron, /api/campaigns/cron
CRON_SECRET=generate-a-long-random-string

# Wait-step automations + flow timeout sweep
AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Worker HTTP + Socket.IO
WORKER_SOCKET_PORT=4000

# Optional
# ALLOWED_INVITE_HOSTS=crm.example.com
# WHATSAPP_TEMPLATES_DRY_RUN=false
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
